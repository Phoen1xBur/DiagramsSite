# Production frontend image. Set FRONTEND_DOCKERFILE=Dockerfile.prod in .env
FROM node:20-alpine AS builder

WORKDIR /app

ENV NODE_OPTIONS=--dns-result-order=ipv4first

COPY package.json package-lock.json* ./
RUN npm config set registry https://registry.npmjs.org/ \
  && npm config set fetch-retries 5 \
  && npm config set fetch-retry-maxtimeout 120000 \
  && npm config set fetch-retry-mintimeout 20000 \
  && npm install --no-audit --no-fund --progress=false

COPY . .

# GIT_SHA MUST be passed at build time: frontend context has no .git
#   GIT_SHA=$(git rev-parse --short HEAD) docker compose build frontend
#   docker compose build --build-arg GIT_SHA=$(git rev-parse --short HEAD) frontend
# On Windows PowerShell: $env:GIT_SHA = (git rev-parse --short HEAD); docker compose build frontend
ARG VITE_DEBUG=False
ARG VITE_API_BASE_URL=/api/v1
ARG GIT_SHA
ENV VITE_DEBUG=$VITE_DEBUG
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
ENV VITE_GIT_SHA=$GIT_SHA

RUN if [ -z "$VITE_GIT_SHA" ] || [ "$VITE_GIT_SHA" = "dev" ]; then \
      echo "ERROR: GIT_SHA build-arg is required for production (got '$VITE_GIT_SHA')." >&2; \
      echo "Pass: --build-arg GIT_SHA=\$(git rev-parse --short HEAD)" >&2; \
      exit 1; \
    fi \
  && npm run build

# Static serve on 5173; nginx proxies the domain here
FROM node:20-alpine

RUN npm install -g serve

WORKDIR /app
COPY --from=builder /app/dist ./dist

EXPOSE 5173
CMD ["serve", "-s", "dist", "-l", "5173"]
