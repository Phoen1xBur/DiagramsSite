# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sunburst_db

# Backend
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/sunburst_db
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:80"]
SECRET_KEY=change-this-in-production

# Прод-фронт: FRONTEND_MOUNT_PATH=/src — чтобы ./frontend монтировался не в /app (иначе затрётся собранный dist в образе). Оба задавать вместе.
FRONTEND_DOCKERFILE=Dockerfile.prod
FRONTEND_MOUNT_PATH=/src

# Frontend. Для прод-сборки при проверке без nginx: VITE_API_BASE_URL=http://localhost:18000/api/v1
VITE_DEBUG=False
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Short commit SHA baked into production frontend build (required with Dockerfile.prod).
# Set before build: GIT_SHA=$(git rev-parse --short HEAD)  OR  docker compose build --build-arg GIT_SHA=...
# GIT_SHA=

# PostgreSQL external port (optional, comment out to disable external access)
# POSTGRES_EXTERNAL_PORT=5432

# Redis external port (optional, comment out to disable external access)
# REDIS_EXTERNAL_PORT=6379
